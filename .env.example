# Clave de API de Google Gemini (requerida)
# Obtener en: https://aistudio.google.com/
GEMINI_API_KEY=tu_api_key_aqui

# Modelo Gemini a utilizar (opcional, default: gemini-3.8-flash)
# Opciones recomendadas: gemini-3.6-flash, gemini-3.8-flash
GEMINI_MODEL=gemini-3.6-flash

# Proveedor LLM (opcional, default: gemini. Opciones: gemini, nvidia)
# LLM_PROVIDER=nvidia

# Configuración NVIDIA Build (requerida si LLM_PROVIDER=nvidia)
# Obtener en: https://build.nvidia.com/
# NVIDIA_API_KEY=tu_nvidia_api_key_aqui
# NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731
